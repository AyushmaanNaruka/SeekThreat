# Copy to .env and fill in. Never commit .env.

# --- Database ---
POSTGRES_USER=seekthreat
POSTGRES_PASSWORD=changeme
POSTGRES_DB=seekthreat
# The localhost values below are for native dev (running apps/api outside
# Docker, against the published ports). Inside the `core` compose profile,
# infra/docker-compose.yml overrides DATABASE_URL/REDIS_URL on the api/worker/
# migrate services to point at the postgres/redis service names instead --
# localhost inside a container is the container itself, not its neighbors.
DATABASE_URL=postgresql://seekthreat:changeme@localhost:5432/seekthreat

# --- Graph projection (profile: viz, from November) ---
# Neo4j is a READ-ONLY projection for visualization. Never a source of truth.
# Written only by POST /engagements/{id}/attack-graph/project (or
# `python -m apps.api.cli.project_graph`); leave NEO4J_URI unset to disable it.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# --- Queue ---
REDIS_URL=redis://localhost:6379/0

# --- API ---
# Comma-separated list of origins the browser dashboard (apps/web) may call
# this API from. The default already covers the Next.js dev server
# (`npm run dev`, http://localhost:3000); add more, comma-separated, for
# other local ports or environments.
CORS_ORIGINS=http://localhost:3000

# --- Intelligence sources ---
# Local feed mirrors: written by the feed sync job (Celery beat task or
# `python -m services.enrichment.sync_feeds`), read by the API and worker.
# Relative paths resolve against the working directory. Inside the `core`
# compose profile this is overridden to /data/enrichment_cache (a shared volume).
ENRICHMENT_CACHE_DIR=data/enrichment_cache
# Optional. Without a key the targeted NVD sync is limited to 5 requests / 30 s.
# https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
GITHUB_TOKEN=

# --- Model serving (profile: model) ---
# Native dev: http://localhost:11434. Inside compose the api/worker are pointed at
# http://ollama:11434 regardless of this value. OLLAMA_HOST is accepted as an alias.
OLLAMA_BASE_URL=http://localhost:11434
# D-006 targets Foundation-Sec-8B-Reasoning; until it is pulled on dev machines the
# default text model is qwen2.5:7b. Changing the embed model needs a re-index.
ASSISTANT_MODEL=qwen2.5:7b
ASSISTANT_EMBED_MODEL=nomic-embed-text
# Optional frontier fallback for comparison runs
ANTHROPIC_API_KEY=

# --- Scanners ---
GVM_HOST=localhost
GVM_PORT=9390
GVM_USER=admin
GVM_PASSWORD=changeme

# --- Safety ---
# The scan allowlist is no longer a global env var — it lives on the Authorization
# record attached to each Engagement (packages/schema/models/engagement.py).
# Authorization is not optional; there is no toggle to disable it.
